# macOS
.DS_Store

# The user's personal brand file (created at the repo root by the brand-setup skill).
# Only the root-level BRAND.md is ignored; the demo file in assets/demo-brand/ stays tracked.
/BRAND.md

# Generated state carries customer identifiers (ad account, campaign, ad set, ad, creative,
# and media IDs; account audits; research on named competitors; performance numbers).
# Every generated artifact below stays local and is never committed.
outputs/
memory/
research/
ad-runs/
reports/

# Logs
*.log

# Python
__pycache__/

# Meta Ads CLI credentials (Route B). Never commit.
.env
.env.*
!.env.example

# Local-only working notes on the maintainer's machine (not part of the public pack)
ARCHITECTURE.md
SESSION_LOG.md
