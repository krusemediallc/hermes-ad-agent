# macOS
.DS_Store

# The user's personal brand file (created at the repo root by the brand-setup skill).
# Only the root-level BRAND.md is ignored; the demo file in assets/demo-brand/ stays tracked.
/BRAND.md

# Generated creatives and downloads
outputs/

# Per-account audit memory written by the account-audit skill (user data, never commit)
memory/

# Logs
*.log

# Python
__pycache__/

# Meta Ads CLI credentials (Route B). Never commit.
.env
.env.*
!.env.example

# Local-only working notes on the maintainer's machine (not part of the public pack)
ARCHITECTURE.md
SESSION_LOG.md
