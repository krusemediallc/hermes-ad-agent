# Meta Ads CLI credentials (Route B only). Copy this file to `.env` at the workspace root
# (the repo clone directory) and fill in the values. Skip it entirely on the Meta MCP route.
# AD_ACCOUNT_ID uses the act_ prefix, for example act_123456.
# BUSINESS_ID is optional (only catalog and dataset commands need it); leave it empty otherwise.
# Never commit `.env`. It is gitignored; only this example file is tracked.
ACCESS_TOKEN='<ACCESS_TOKEN>'
AD_ACCOUNT_ID='<AD_ACCOUNT_ID>'
BUSINESS_ID=''
